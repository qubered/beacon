# Core: API, UI, alerting, ingest, storage — and a local agent (D13).
FROM node:22-alpine AS web
WORKDIR /web
COPY web/package.json web/pnpm-lock.yaml* ./
RUN corepack enable && pnpm install --frozen-lockfile || pnpm install
COPY web/ ./
RUN pnpm build

FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
COPY --from=web /web/dist ./web/dist
ARG VERSION=0.0.0-dev
ARG COMMIT=none
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags "-s -w -X github.com/qubered/beacon/internal/buildinfo.Version=${VERSION} -X github.com/qubered/beacon/internal/buildinfo.Commit=${COMMIT}" \
    -o /out/beacon ./cmd/beacon && \
    CGO_ENABLED=0 go build -trimpath -o /out/beaconctl ./cmd/beaconctl

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 10001 beacon
COPY --from=build /out/beacon /out/beaconctl /usr/local/bin/
USER beacon
EXPOSE 8080 8081 9090
ENTRYPOINT ["beacon"]
